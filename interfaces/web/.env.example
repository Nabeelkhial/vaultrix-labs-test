# Vaultrix Labs web — copy to interfaces/web/.env and fill in. NEVER commit .env.
# Register an OAuth App at https://github.com/settings/developers (see README).
VAULTRIX_GH_CLIENT_ID=
VAULTRIX_GH_CLIENT_SECRET=
# A random 32+ byte hex string for signing session cookies, e.g.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
VAULTRIX_SECRET_KEY=
